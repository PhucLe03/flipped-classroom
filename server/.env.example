PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/flipped_classroom
JWT_SECRET=flipped_classroom_secret_jwt_key_2026_super_secure
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# --- Data safety flags (optional) ---
# AUTO_SEED=true|false          # Default: only seeds on local/in-memory DB outside production
# ALLOW_MEMORY_DB=true          # Force in-memory MongoDB fallback (tests only)
# ALLOW_DESTRUCTIVE_SEED=true   # Allow seedData(true) to wipe a remote DB (DANGEROUS)
